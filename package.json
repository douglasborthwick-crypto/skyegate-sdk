{
  "name": "@skyemeta/skyegate",
  "version": "0.1.2",
  "description": "SkyeGate Pro for Vercel — condition-based content gating for Next.js apps. Powered by InsumerAPI. Companion to the SkyeGate WordPress plugin: same SKYE license key, one license, two stacks.",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./react": {
      "import": "./build/react.js",
      "types": "./build/react.d.ts"
    }
  },
  "files": [
    "build",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "skyegate",
    "skyemeta",
    "condition-based-access",
    "wallet-auth",
    "token-gating",
    "nft-gating",
    "farcaster",
    "vercel",
    "nextjs",
    "react",
    "web3",
    "ecdsa",
    "jwt",
    "attestation"
  ],
  "author": "Skye Meta Corp.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/douglasborthwick-crypto/skyegate-sdk.git"
  },
  "homepage": "https://skyemeta.com/skyegate/vercel/",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "jose": "^5.9.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0"
  }
}
